# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev"

# better-auth
BETTER_AUTH_SECRET="your-secret-here-change-in-production"
BETTER_AUTH_URL="http://localhost:8000"

# Admin panel: comma-separated emails that get admin access (leave empty for none)
ADMIN_EMAILS="admin@example.com"

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# API
PORT=8000
BASE_URL="http://localhost:8000"
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/trpc"
VITE_API_URL="http://localhost:8000/trpc"
# Cloudflare Turnstile site key (client-side; leave empty to disable)
VITE_TURNSTILE_SITE_KEY=""

# Cloudflare Turnstile (bot protection; leave empty to disable)
TURNSTILE_SECRET_KEY=""

# Email (SMTP / Nodemailer; leave empty to disable emails)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="Formforge <noreply@example.com>"
