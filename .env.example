# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev"

# better-auth
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="your-secret-here-change-in-production"
# Public API origin only; do not include /trpc or /auth.
BETTER_AUTH_URL="http://localhost:8000"

# Admin panel: comma-separated emails that get admin access (leave empty for none)
ADMIN_EMAILS="admin@example.com"

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# API (CORS is restricted to FRONTEND_URL in development and production)
PORT=8000
# Public API origin only; do not include /trpc.
BASE_URL="http://localhost:8000"
NODE_ENV=development
# Comma-separated list of allowed browser origins.
FRONTEND_URL="http://localhost:3000"
# Set to the proxy header carrying the real client IP (e.g. "x-forwarded-for")
# ONLY when running behind a load balancer. Left unset, the header is ignored
# so it cannot be spoofed to bypass rate limits.
# TRUST_PROXY="x-forwarded-for"

# Custom domains (leave empty to disable)
# Hostname that custom domains should CNAME to. When set, owners get a CNAME
# option in addition to the TXT challenge below. TLS must terminate at your
# edge for the domain to actually serve.
# DOMAIN_VERIFICATION_DNS_TARGET="domains.example.com"
# Subdomain prefix the TXT challenge is published under.
# DOMAIN_VERIFICATION_TXT_PREFIX="_formly"

# Webhook delivery worker
# First attempts are sent inline with the event; these govern the retries for
# receivers that were down, rate-limiting, or unreachable at that moment.
# Disable the worker entirely with 0 (retries then never happen).
# WEBHOOK_WORKER_INTERVAL_MS=15000
# First retry delay; doubles per attempt, with jitter.
# WEBHOOK_RETRY_BASE_MS=15000
# Ceiling for that backoff.
# WEBHOOK_RETRY_MAX_MS=3600000
# Attempts before a delivery is dead-lettered and stops retrying.
# WEBHOOK_MAX_ATTEMPTS=5
# Consecutive failures before a webhook is switched off automatically.
# Set 0 to never auto-disable (a dead endpoint then stays active and retries).
# WEBHOOK_AUTO_DISABLE_FAILURES=25
# How long settled deliveries (success + dead) are kept in the delivery log.
# WEBHOOK_RETENTION_DAYS=30

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/trpc"
VITE_API_URL="http://localhost:8000/trpc"
# Cloudflare Turnstile site key (client-side; leave empty to disable)
VITE_TURNSTILE_SITE_KEY=""

# Cloudflare Turnstile (bot protection; leave empty to disable)
TURNSTILE_SECRET_KEY=""

# Razorpay payments (leave empty to disable payments on published forms)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Razorpay plan id for Pro subscriptions (create the plan in the Razorpay dashboard)
RAZORPAY_PRO_PLAN_ID=""

# Email (SMTP / Nodemailer; leave empty to disable emails)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="user@example.com"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="Formly <noreply@example.com>"
