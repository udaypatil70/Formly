# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dev"

# better-auth
BETTER_AUTH_SECRET="your-secret-here-change-in-production"
BETTER_AUTH_URL="http://localhost:8000"

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# API
PORT=8000
BASE_URL="http://localhost:8000"
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/trpc"
VITE_API_URL="http://localhost:8000/trpc"
# Cloudflare Turnstile site key (client-side; leave empty to disable)
VITE_TURNSTILE_SITE_KEY=""

# Cloudflare Turnstile (bot protection; leave empty to disable)
TURNSTILE_SECRET_KEY=""
